# Public URLs for each Yado microservice (used for links + SSO redirect)
NEXT_PUBLIC_SSO_URL=https://sso.yado.my.id
NEXT_PUBLIC_MALAS_URL=https://malas.yado.my.id

# OAuth-style SSO login config (adjust to match sso.yado's actual flow)
NEXT_PUBLIC_SSO_CLIENT_ID=yado-landing
NEXT_PUBLIC_SSO_REDIRECT_URI=https://yado.my.id/auth/callback

# Server-side health check endpoints polled by /api/health (kept off the client so
# internal/private hostnames never leak to the browser)
SSO_HEALTH_URL=https://sso.yado.my.id/health
MALAS_HEALTH_URL=https://malas.yado.my.id/health

# Optional: libs has no public health endpoint yet. Set this once it does;
# until then the status page reports it as "unknown" rather than guessing.
LIBS_HEALTH_URL=
