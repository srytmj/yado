# Public URLs for each White Archive microservice (used for links + SSO redirect)
NEXT_PUBLIC_SSO_URL=https://sso.suryatmaja.dev
NEXT_PUBLIC_MALAS_URL=https://malas.suryatmaja.dev

# OAuth-style SSO login config (adjust to match sso.whitearchive's actual flow)
NEXT_PUBLIC_SSO_CLIENT_ID=whitearchive-landing
NEXT_PUBLIC_SSO_REDIRECT_URI=https://suryatmaja.dev/auth/callback

# Server-side health check endpoints polled by /api/health (kept off the client so
# internal/private hostnames never leak to the browser)
SSO_HEALTH_URL=https://sso.suryatmaja.dev/health
MALAS_HEALTH_URL=https://malas.suryatmaja.dev/health
